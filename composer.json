{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "bugsnag/bugsnag-laravel": "^2.0",
        "darkaonline/l5-swagger": "^8.0",
        "google/apiclient": "^2.15",
        "guzzlehttp/guzzle": "^7.7",
        "laravel/framework": "^10.10",
        "laravel/passport": "*",
        "laravel/sanctum": "^3.2",
        "laravel/scout": "^10.11",
        "laravel/socialite": "^5.10",
        "laravel/tinker": "^2.8",
        "masterro/laravel-mail-viewer": "^2.2",
        "mollie/laravel-mollie": "^2.25",
        "musonza/chat": "^6.2",
        "pbmedia/laravel-ffmpeg": "^8.4",
        "php-ffmpeg/php-ffmpeg": "^1.2",
        "socialiteproviders/microsoft-azure": "^5.1",
        "spatie/icalendar-generator": "^2.6",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-google-calendar": "^3.7",
        "spatie/laravel-pdf": "^1.5",
        "symfony/css-selector": "^6.4",
        "symfony/dom-crawler": "^7.1",
        "twilio/sdk": "^8.3",
        "typesense/laravel-scout-typesense-driver": "^5.2",
        "typesense/typesense-php": "^4.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "krlove/eloquent-model-generator": "^2.0",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
